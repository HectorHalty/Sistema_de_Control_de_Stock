// Esquema Prisma — Sistema de Gestión LCH (La Chacra Fútbol)
// PostgreSQL · modelos en español · optimizado para ventas + stock

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== AUTH ====================

model Usuario {
  id        String   @id @default(uuid())
  username  String   @unique
  name      String
  role      String   @default("Operador")
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesTickets TicketVenta[]      @relation("TicketsOperador")
  auditEntries EntradaAuditoria[]

  @@map("usuarios")
}

// ==================== STOCK / INVENTARIO ====================

model Categoria {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Producto[]

  @@map("categorias")
}

model Deposito {
  id        String   @id @default(uuid())
  name      String   @unique
  location  String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLevels NivelStock[]
  movimientos MovimientoStock[]
  consumos    ConsumoEmpleado[]

  @@map("depositos")
}

model Producto {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  categoryId  String
  unit        String   @default("unidades")
  orderUnit   Int?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category           Categoria           @relation(fields: [categoryId], references: [id])
  stockLevels        NivelStock[]
  recipeItems        ItemReceta[]
  supplierProducts   ProveedorProducto[]
  purchaseOrderItems ItemOrdenCompra[]
  movimientos        MovimientoStock[]
  consumos           ConsumoEmpleado[]
  conteoEntradas     EntradaConteo[]
  productosOnline    ProductoOnline[]

  @@index([categoryId])
  @@index([name])
  @@map("productos")
}

model NivelStock {
  id          String   @id @default(uuid())
  productId   String
  warehouseId String
  quantity    Decimal  @default(0) @db.Decimal(12, 3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Producto @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Deposito @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("niveles_stock")
}

model Proveedor {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       ProveedorProducto[]
  purchaseOrders OrdenCompra[]

  @@map("proveedores")
}

model ProveedorProducto {
  id         String   @id @default(uuid())
  supplierId String
  productId  String
  createdAt  DateTime @default(now())

  supplier Proveedor @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Producto  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([productId])
  @@map("proveedores_productos")
}

// ==================== VENTAS ====================

model ProductoVenta {
  id             String   @id @default(uuid())
  name           String
  category       String   @default("Comidas")
  kitchenId      String
  price          Decimal  @db.Decimal(10, 2)
  emoji          String?
  kind           String   @default("simple") // simple | promo
  active         Boolean  @default(true)
  visibleWeb     Boolean  @default(false)
  descripcionWeb String?
  imagenWeb      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  recipe        ItemReceta[]
  bundleItems   ItemComboVenta[]  @relation("PromoProduct")
  usedInBundles ItemComboVenta[]  @relation("BundleComponent")
  ticketItems   ItemTicketVenta[]
  kitchen       Cocina            @relation(fields: [kitchenId], references: [id])
  kitchenItems  ItemOrdenCocina[]

  // Evita el mismo nombre de carta duplicado en la misma cocina
  @@unique([name, kitchenId])
  @@index([kitchenId])
  @@index([active, kitchenId])
  @@index([active, name])
  @@index([visibleWeb, active])
  @@map("productos_venta")
}

model ItemComboVenta {
  id                 String   @id @default(uuid())
  promoProductId     String
  componentProductId String
  quantity           Int      @default(1)
  createdAt          DateTime @default(now())

  promoProduct     ProductoVenta @relation("PromoProduct", fields: [promoProductId], references: [id], onDelete: Cascade)
  componentProduct ProductoVenta @relation("BundleComponent", fields: [componentProductId], references: [id], onDelete: Restrict)

  @@unique([promoProductId, componentProductId])
  @@index([promoProductId])
  @@index([componentProductId])
  @@map("items_combo_venta")
}

model ItemReceta {
  id             String   @id @default(uuid())
  salesProductId String
  stockProductId String
  quantity       Decimal  @db.Decimal(12, 3)
  createdAt      DateTime @default(now())

  salesProduct ProductoVenta @relation(fields: [salesProductId], references: [id], onDelete: Cascade)
  stockProduct Producto      @relation(fields: [stockProductId], references: [id], onDelete: Cascade)

  @@unique([salesProductId, stockProductId])
  @@index([salesProductId])
  @@index([stockProductId])
  @@map("items_receta")
}

model TicketVenta {
  id             String   @id @default(uuid())
  number         Int      @unique
  createdAt      DateTime @default(now())
  status         String   @default("emitido") // emitido, anulado, devuelto
  total          Decimal  @db.Decimal(10, 2)
  operatorId     String
  note           String?
  idempotencyKey String?  @unique
  origen         String   @default("pos") // pos | online

  operator      Usuario           @relation("TicketsOperador", fields: [operatorId], references: [id])
  items         ItemTicketVenta[]
  kitchenOrders OrdenCocina[]
  pedidoPublico PedidoPublico?

  @@index([operatorId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([origen])
  @@map("tickets_venta")
}

model ItemTicketVenta {
  id             String   @id @default(uuid())
  ticketId       String
  salesProductId String
  name           String // snapshot al momento de la venta (intencional)
  unitPrice      Decimal  @db.Decimal(10, 2) // snapshot
  quantity       Int
  createdAt      DateTime @default(now())

  ticket       TicketVenta   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  salesProduct ProductoVenta @relation(fields: [salesProductId], references: [id])

  @@index([ticketId])
  @@index([salesProductId])
  @@map("items_ticket_venta")
}

/// Contador atómico para números de ticket (evita MAX+1 y duplicados bajo concurrencia)
model ContadorTicket {
  id    String @id @default("default")
  valor Int    @default(1000)

  @@map("contadores_ticket")
}

/// Contador atómico para pedidos de compra (PED-001…)
model ContadorPedido {
  id    String @id @default("default")
  valor Int    @default(0)

  @@map("contadores_pedido")
}

// ==================== COCINA (KDS) ====================

model Cocina {
  id        String   @id @default(uuid())
  name      String   @unique
  emoji     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesProducts ProductoVenta[]
  orders        OrdenCocina[]

  @@index([active])
  @@map("cocinas")
}

model OrdenCocina {
  id              String   @id @default(uuid())
  ticketId        String
  ticketNumber    Int // snapshot del número de ticket (consulta KDS rápida)
  kitchenId       String
  status          String   @default("pending") // pending, preparing, ready, delivered
  operatorName    String
  tableId         String?
  tableName       String?
  pedidoPublicoId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ticket        TicketVenta       @relation(fields: [ticketId], references: [id])
  kitchen       Cocina            @relation(fields: [kitchenId], references: [id])
  pedidoPublico PedidoPublico?    @relation(fields: [pedidoPublicoId], references: [id], onDelete: SetNull)
  items         ItemOrdenCocina[]

  @@index([ticketId])
  @@index([kitchenId])
  @@index([status])
  @@index([pedidoPublicoId])
  @@index([kitchenId, status, createdAt])
  @@map("ordenes_cocina")
}

model ItemOrdenCocina {
  id             String   @id @default(uuid())
  kitchenOrderId String
  salesProductId String
  name           String // snapshot
  quantity       Int
  emoji          String?
  createdAt      DateTime @default(now())

  kitchenOrder OrdenCocina   @relation(fields: [kitchenOrderId], references: [id], onDelete: Cascade)
  salesProduct ProductoVenta @relation(fields: [salesProductId], references: [id])

  @@index([kitchenOrderId])
  @@index([salesProductId])
  @@map("items_orden_cocina")
}

// ==================== MEDIA / UPLOADS ====================

model Medio {
  id        String   @id @default(uuid())
  title     String
  type      String
  url       String
  mimeType  String
  size      Int
  bucket    String   @default("lch-media")
  key       String   @unique
  matchDate String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([matchDate])
  @@map("medios")
}

// ==================== PATROCINADORES ====================

model Patrocinador {
  id        String   @id @default(uuid())
  name      String
  imageUrl  String
  placement String   @default("banner")
  active    Boolean  @default(true)
  linkUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([placement])
  @@map("patrocinadores")
}

// ==================== CATÁLOGO ONLINE ====================

model ProductoOnline {
  id             String   @id @default(uuid())
  name           String
  description    String?
  price          Decimal  @db.Decimal(10, 2)
  image          String?
  images         String[] @default([])
  category       String
  attributes     Json?
  active         Boolean  @default(true)
  stockProductId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stockProduct Producto? @relation(fields: [stockProductId], references: [id], onDelete: SetNull)

  @@index([active])
  @@index([category])
  @@index([stockProductId])
  @@map("productos_online")
}

// ==================== FÚTBOL / TORNEO PÚBLICO ====================

model Temporada {
  id        String   @id @default(uuid())
  nombre    String
  anio      Int
  activa    Boolean  @default(false)
  inicio    DateTime
  fin       DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campeonatos Campeonato[]

  @@unique([anio])
  @@index([activa])
  @@map("temporadas")
}

model Campeonato {
  id          String    @id @default(uuid())
  temporadaId String
  nombre      String // Apertura | Clausura
  activo      Boolean   @default(false)
  inicio      DateTime?
  fin         DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  temporada Temporada @relation(fields: [temporadaId], references: [id], onDelete: Cascade)
  torneos   Torneo[]

  @@unique([temporadaId, nombre])
  @@index([activo])
  @@map("campeonatos")
}

model CategoriaConfig {
  id                 String   @id @default(uuid())
  codigo             String   @unique // hombres_libre_a, mujeres_b, etc.
  nombre             String
  genero             String // hombres | mujeres
  maxPlantel         Int
  maxIncorporaciones Int      @default(3)
  minJugadoresInicio Int
  grupoCanchasId     String?
  colorHex           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  grupoCanchas GrupoCanchas? @relation(fields: [grupoCanchasId], references: [id], onDelete: SetNull)
  torneos      Torneo[]

  @@map("categorias_config")
}

model Torneo {
  id           String   @id @default(uuid())
  campeonatoId String
  categoriaId  String
  nombre       String
  activo       Boolean  @default(false)
  publicado    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campeonato    Campeonato           @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  categoria     CategoriaConfig      @relation(fields: [categoriaId], references: [id])
  config        TorneoConfig?
  inscripciones EquipoInscripcion[]
  jugadores     InscripcionJugador[]
  partidos      PartidoFutbol[]
  jornadas      Jornada[]
  capitanes     CapitanAutorizado[]
  preferencias  PreferenciaHorario[]

  @@unique([campeonatoId, categoriaId])
  @@index([activo, publicado])
  @@map("torneos")
}

model TorneoConfig {
  id                        String   @id @default(uuid())
  torneoId                  String   @unique
  puntosVictoria            Int      @default(3)
  puntosEmpate              Int      @default(1)
  puntosDerrota             Int      @default(0)
  resultadoWO               String   @default("3-0")
  descuentoPuntosWOSinAviso Int      @default(6)
  descuentoPuntosWOConAviso Int      @default(3)
  criteriosDesempate        Json     @default("[\"difGoles\",\"golesContra\",\"enfrentamientoDirecto\",\"fairPlay\",\"expulsados\",\"sorteo\"]")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  torneo Torneo @relation(fields: [torneoId], references: [id], onDelete: Cascade)

  @@map("torneos_config")
}

model EquipoFutbol {
  id        String   @id @default(uuid())
  name      String   @unique
  shortName String?
  logo      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeMatches   PartidoFutbol[]     @relation("HomeTeam")
  awayMatches   PartidoFutbol[]     @relation("AwayTeam")
  inscripciones EquipoInscripcion[]

  @@map("equipos_futbol")
}

model EquipoInscripcion {
  id                String   @id @default(uuid())
  torneoId          String
  equipoId          String
  abbr              String?
  color             String?
  descuentoPuntosWO Int      @default(0)
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  torneo       Torneo               @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  equipo       EquipoFutbol         @relation(fields: [equipoId], references: [id])
  jugadores    InscripcionJugador[]
  capitanes    CapitanAutorizado[]
  homePartidos PartidoFutbol[]      @relation("HomeInscripcion")
  awayPartidos PartidoFutbol[]      @relation("AwayInscripcion")
  byePartidos  PartidoFutbol[]      @relation("EquipoLibre")
  preferencias PreferenciaHorario[]
  seguidores   CuentaPublica[]      @relation("EquipoSeguido")

  @@unique([torneoId, equipoId])
  @@index([torneoId, activo])
  @@map("equipos_inscripcion")
}

model Persona {
  id                 String    @id @default(uuid())
  dni                String    @unique
  nombre             String
  apellido           String
  email              String?
  telefonoCelular    String?
  telefonoParticular String?
  telefonoLaboral    String?
  fechaNacimiento    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  cuentaPublica CuentaPublica?
  inscripciones InscripcionJugador[]
  eventos       EventoPartido[]
  suspensiones  Suspension[]

  @@index([email])
  @@map("personas")
}

model CuentaPublica {
  id              String   @id @default(uuid())
  googleId        String   @unique
  email           String   @unique
  avatarUrl       String?
  rol             String   @default("usuario") // usuario | seguidor | jugador | capitan
  personaId       String?  @unique
  equipoSeguidoId String?
  dniConfirmado   String?
  notifPartidos   Boolean  @default(true)
  notifPedidos    Boolean  @default(true)
  notifTorneo     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  persona           Persona?           @relation(fields: [personaId], references: [id], onDelete: SetNull)
  equipoSeguido     EquipoInscripcion? @relation("EquipoSeguido", fields: [equipoSeguidoId], references: [id], onDelete: SetNull)
  capitanAutorizado CapitanAutorizado?
  pedidos           PedidoPublico[]

  @@index([rol])
  @@index([equipoSeguidoId])
  @@map("cuentas_publicas")
}

model CapitanAutorizado {
  id                  String   @id @default(uuid())
  email               String
  dni                 String
  equipoInscripcionId String
  torneoId            String
  activo              Boolean  @default(true)
  cuentaPublicaId     String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  equipoInscripcion EquipoInscripcion @relation(fields: [equipoInscripcionId], references: [id], onDelete: Cascade)
  torneo            Torneo            @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  cuentaPublica     CuentaPublica?    @relation(fields: [cuentaPublicaId], references: [id], onDelete: SetNull)

  @@unique([email, torneoId])
  @@unique([dni, torneoId])
  @@index([email])
  @@index([equipoInscripcionId])
  @@map("capitanes_autorizados")
}

model InscripcionJugador {
  id                  String   @id @default(uuid())
  personaId           String
  torneoId            String
  equipoInscripcionId String
  numeroCamiseta      Int?
  rolPlantel          String   @default("jugador") // jugador | capitan | subcapitan
  activa              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  persona           Persona           @relation(fields: [personaId], references: [id], onDelete: Cascade)
  torneo            Torneo            @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  equipoInscripcion EquipoInscripcion @relation(fields: [equipoInscripcionId], references: [id], onDelete: Cascade)

  @@unique([personaId, torneoId])
  @@index([equipoInscripcionId, activa])
  @@index([torneoId, activa])
  @@map("inscripciones_jugador")
}

model GrupoCanchas {
  id        String   @id @default(uuid())
  codigo    String   @unique // mujeres | hombres_a | hombres_b
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  canchas    Cancha[]
  franjas    FranjaHoraria[]
  categorias CategoriaConfig[]

  @@map("grupos_canchas")
}

model Cancha {
  id             String   @id @default(uuid())
  grupoCanchasId String
  numero         Int
  nombre         String?
  activa         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  grupoCanchas GrupoCanchas    @relation(fields: [grupoCanchasId], references: [id], onDelete: Cascade)
  partidos     PartidoFutbol[]

  @@unique([grupoCanchasId, numero])
  @@index([numero])
  @@map("canchas")
}

model FranjaHoraria {
  id              String   @id @default(uuid())
  grupoCanchasId  String
  horaInicio      String // HH:mm
  duracionMinutos Int      @default(90)
  orden           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  grupoCanchas GrupoCanchas @relation(fields: [grupoCanchasId], references: [id], onDelete: Cascade)

  @@unique([grupoCanchasId, horaInicio])
  @@index([grupoCanchasId, orden])
  @@map("franjas_horarias")
}

model Jornada {
  id             String   @id @default(uuid())
  torneoId       String
  numero         Int
  fecha          DateTime
  suspendida     Boolean  @default(false)
  esRecuperacion Boolean  @default(false)
  publicada      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  torneo       Torneo               @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  partidos     PartidoFutbol[]
  preferencias PreferenciaHorario[]

  @@unique([torneoId, numero])
  @@index([torneoId, fecha])
  @@index([suspendida])
  @@map("jornadas")
}

model PreferenciaHorario {
  id                  String   @id @default(uuid())
  torneoId            String
  jornadaId           String
  equipoInscripcionId String
  horaPreferida       String
  createdAt           DateTime @default(now())

  torneo            Torneo            @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  jornada           Jornada           @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  equipoInscripcion EquipoInscripcion @relation(fields: [equipoInscripcionId], references: [id], onDelete: Cascade)

  @@unique([jornadaId, equipoInscripcionId])
  @@index([torneoId])
  @@map("preferencias_horario")
}

model PartidoFutbol {
  id                String   @id @default(uuid())
  homeTeamId        String
  awayTeamId        String
  date              DateTime
  status            String   @default("pendiente") // pendiente | jugado | suspendido | wo
  homeGoals         Int?
  awayGoals         Int?
  venue             String?
  torneoId          String?
  jornadaId         String?
  homeInscripcionId String?
  awayInscripcionId String?
  canchaId          String?
  horaInicio        String?
  bloqueadoManual   Boolean  @default(false)
  equipoLibreId     String?
  esWO              Boolean  @default(false)
  motivoWO          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  homeTeam        EquipoFutbol       @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam        EquipoFutbol       @relation("AwayTeam", fields: [awayTeamId], references: [id])
  torneo          Torneo?            @relation(fields: [torneoId], references: [id], onDelete: SetNull)
  jornada         Jornada?           @relation(fields: [jornadaId], references: [id], onDelete: SetNull)
  homeInscripcion EquipoInscripcion? @relation("HomeInscripcion", fields: [homeInscripcionId], references: [id], onDelete: SetNull)
  awayInscripcion EquipoInscripcion? @relation("AwayInscripcion", fields: [awayInscripcionId], references: [id], onDelete: SetNull)
  cancha          Cancha?            @relation(fields: [canchaId], references: [id], onDelete: SetNull)
  equipoLibre     EquipoInscripcion? @relation("EquipoLibre", fields: [equipoLibreId], references: [id], onDelete: SetNull)
  eventos         EventoPartido[]

  @@index([status])
  @@index([date])
  @@index([status, date])
  @@index([torneoId, jornadaId])
  @@index([canchaId, date, horaInicio])
  @@map("partidos_futbol")
}

model EventoPartido {
  id          String   @id @default(uuid())
  partidoId   String
  personaId   String
  tipo        String // gol | asistencia | amarilla | roja | azul | doble_amarilla | expulsion_directa
  minuto      Int?
  articuloRef String?
  createdAt   DateTime @default(now())

  partido PartidoFutbol @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  persona Persona       @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([partidoId])
  @@index([personaId])
  @@index([tipo])
  @@map("eventos_partido")
}

model Suspension {
  id              String   @id @default(uuid())
  personaId       String
  torneoId        String?
  motivo          String
  fechasRestantes Int      @default(1)
  activa          Boolean  @default(true)
  origenPartidoId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  persona Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([personaId, activa])
  @@index([torneoId, activa])
  @@map("suspensiones")
}

// ==================== REGLAMENTO ====================

model ReglamentoApartado {
  id        String   @id @default(uuid())
  numero    Int      @unique
  titulo    String
  orden     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articulos ReglamentoArticulo[]

  @@map("reglamento_apartados")
}

model ReglamentoArticulo {
  id         String   @id @default(uuid())
  apartadoId String
  numero     String // "1", "10 bis", "38 bis"
  titulo     String?
  contenido  String   @db.Text
  aplicable  Boolean  @default(true)
  orden      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  apartado ReglamentoApartado @relation(fields: [apartadoId], references: [id], onDelete: Cascade)

  @@unique([apartadoId, numero])
  @@index([aplicable])
  @@map("reglamento_articulos")
}

model ReglamentoAnexo {
  id        String   @id @default(uuid())
  numero    Int      @unique
  titulo    String
  orden     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reglas ReglamentoRegla[]

  @@map("reglamento_anexos")
}

model ReglamentoRegla {
  id        String   @id @default(uuid())
  anexoId   String
  clave     String
  titulo    String?
  contenido String   @db.Text
  orden     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  anexo ReglamentoAnexo @relation(fields: [anexoId], references: [id], onDelete: Cascade)

  @@unique([anexoId, clave])
  @@map("reglamento_reglas")
}

// ==================== CANTINA PÚBLICA ====================

model PedidoPublico {
  id              String   @id @default(uuid())
  cuentaPublicaId String
  status          String   @default("pendiente_pago") // pendiente_pago | pagado | en_cocina | listo | retirado | cancelado
  total           Decimal  @db.Decimal(10, 2)
  ticketVentaId   String?  @unique
  nota            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cuentaPublica CuentaPublica       @relation(fields: [cuentaPublicaId], references: [id])
  ticketVenta   TicketVenta?        @relation(fields: [ticketVentaId], references: [id], onDelete: SetNull)
  items         ItemPedidoPublico[]
  tokenRetiro   TokenRetiroQR?
  ordenesCocina OrdenCocina[]

  @@index([cuentaPublicaId])
  @@index([status])
  @@index([createdAt])
  @@map("pedidos_publicos")
}

model ItemPedidoPublico {
  id             String   @id @default(uuid())
  pedidoId       String
  salesProductId String?
  name           String
  unitPrice      Decimal  @db.Decimal(10, 2)
  quantity       Int
  emoji          String?
  createdAt      DateTime @default(now())

  pedido PedidoPublico @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@map("items_pedido_publico")
}

model TokenRetiroQR {
  id        String    @id @default(uuid())
  pedidoId  String    @unique
  token     String    @unique
  usadoEn   DateTime?
  invalido  Boolean   @default(false)
  createdAt DateTime  @default(now())

  pedido PedidoPublico @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("tokens_retiro_qr")
}

// ==================== AUDITORÍA ====================

model EntradaAuditoria {
  id            String   @id @default(uuid())
  userId        String
  action        String
  element       String
  previousValue String?
  newValue      String?
  createdAt     DateTime @default(now())

  user Usuario @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("entradas_auditoria")
}

// ==================== MOVIMIENTOS Y OPERACIONES DE STOCK ====================

model MovimientoStock {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  type         String
  productId    String
  warehouseId  String?
  quantity     Decimal  @db.Decimal(12, 3)
  reference    String?
  operatorId   String? // puede ser id de usuario o valor legacy; sin FK rígida
  operatorName String?

  product   Producto  @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Deposito? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([warehouseId])
  @@index([type])
  @@index([createdAt])
  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([reference])
  @@map("movimientos_stock")
}

model ConsumoEmpleado {
  id            String   @id @default(uuid())
  day           String
  createdAt     DateTime @default(now())
  productId     String
  productName   String // snapshot
  productCode   String?
  warehouseId   String
  warehouseName String // snapshot
  quantity      Decimal  @db.Decimal(12, 3)
  unit          String   @default("unidades")
  previousStock Decimal  @db.Decimal(12, 3)
  newStock      Decimal  @db.Decimal(12, 3)
  operatorId    String?
  operatorName  String?
  operatorRole  String?
  note          String?

  product   Producto @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Deposito @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([warehouseId])
  @@index([day])
  @@index([createdAt])
  @@index([day, productId])
  @@map("consumos_empleado")
}

model SesionConteo {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  date         String
  dateType     String   @default("regular")
  operatorId   String?
  operatorName String?

  entries EntradaConteo[]

  @@index([date])
  @@index([createdAt])
  @@map("sesiones_conteo")
}

model EntradaConteo {
  id          String   @id @default(uuid())
  sessionId   String
  productId   String
  productName String // snapshot
  unit        String   @default("unidades")
  expected    Decimal  @db.Decimal(12, 3)
  counted     Decimal  @db.Decimal(12, 3)
  createdAt   DateTime @default(now())

  session SesionConteo @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product Producto     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([sessionId, productId])
  @@index([sessionId])
  @@index([productId])
  @@map("entradas_conteo")
}

model OrdenCompra {
  id          String    @id @default(uuid())
  orderNumber String    @unique
  date        String
  provider    String
  supplierId  String?
  status      String    @default("Pendiente")
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  supplier Proveedor?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items    ItemOrdenCompra[]

  @@index([status])
  @@index([date])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("ordenes_compra")
}

model ItemOrdenCompra {
  id               String   @id @default(uuid())
  purchaseOrderId  String
  productId        String
  quantityOrdered  Decimal  @db.Decimal(12, 3)
  quantityReceived Decimal? @db.Decimal(12, 3)

  purchaseOrder OrdenCompra @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Producto    @relation(fields: [productId], references: [id])

  @@unique([purchaseOrderId, productId])
  @@index([purchaseOrderId])
  @@index([productId])
  @@map("items_orden_compra")
}

// ==================== CONSUMOS (legacy) ====================

model LogConsumo {
  id        String   @id @default(uuid())
  day       String
  dateType  String   @default("regular")
  createdAt DateTime @default(now())

  entries EntradaConsumo[]

  @@index([day])
  @@index([dateType])
  @@index([day, dateType])
  @@map("logs_consumo")
}

model EntradaConsumo {
  id            String   @id @default(uuid())
  logId         String
  productId     String
  productName   String
  warehouseId   String
  warehouseName String
  previousStock Decimal  @db.Decimal(12, 3)
  newStock      Decimal  @db.Decimal(12, 3)
  consumed      Decimal  @db.Decimal(12, 3)
  unit          String   @default("unidades")
  createdAt     DateTime @default(now())

  log LogConsumo @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([logId])
  @@index([productId])
  @@map("entradas_consumo")
}
